<widget xmlns="http://www.w3.org/ns/widgets" id="com.alipardahouse.app" version="1.0.0">
<name>Alipardahouse</name>
<description>Ali Parda House Offline App</description>
<author email="support@alipardahouse.com">Ali Parda House</author>
<!--  App Startup Page  -->
<content src="index.html"/>
<!--  Offline Permissions & Access  -->
<access origin="*"/>
<allow-intent href="http://*/*"/>
<allow-intent href="https://*/*"/>
<!--  App Preferences  -->
<preference name="Orientation" value="default"/>
<preference name="Fullscreen" value="false"/>
<preference name="BackgroundColor" value="#ffffff"/>
<!--  Custom App Icon Path  -->
<icon src="images/icon.png"/>




  <!-- Splash Screen Settings -->
    <preference name="SplashScreen" value="screen" />
    <preference name="SplashScreenDelay" value="3000" /> <!-- 3 seconds -->
    <preference name="AutoHideSplashScreen" value="true" />
    
    <!-- Splash Image Path -->
    <preference name="AndroidWindowSplashScreenAnimatedIcon" value="images/splash.png" />
    <preference name="AndroidWindowSplashScreenBackground" value="#FFFFFF" />
</widget>
</widget>
